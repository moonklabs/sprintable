# story 4796 — front door. Certificates are issued and renewed by Caddy itself (ports 80/443 must reach it).
# Caddy overwrites any X-Forwarded-For a client sends (no trusted proxies are configured), so the backend's TRUST_FORWARDED_FOR sees the real peer.
# The browser-facing API/MCP/realtime hosts are DNS-only (not behind the Cloudflare proxy) because long-lived SSE is buffered there (design doc §front door).
{
	email {$ACME_EMAIL}
	# the default log of Caddy (its stream of errors, stderr): the same filter as the access log of the two sites below.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}
	servers {
		protocols h1 h2
	}
}

{$API_HOST}, {$REALTIME_HOST} {
	# the access log, to stdout (docker logs; the compose logging limit applies: 5 files of 10 MB): it is how the VM's request rate is measured (story 4796: the machine traffic of the prod move, RUNBOOK §12).
	# No credential is kept: the request headers and the response headers are removed (Caddy hides Authorization and Cookie by default, this keeps the rest of them out too) and so is the whole URI
	# (one-time codes of OAuth callbacks travel in the query string, invitation and public-document tokens in the path: /api/v2/invites/{token}, /api/v2/public/docs/{token}). What is left: time, host, method, status, size, duration,
	# and the client address (Caddy's remote_ip / client_ip, the same as Cloud Run's remoteIp in its request log): an address is personal data, so this log is read for its counts and is not shipped anywhere.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}

	# no `encode`: compressing would hold SSE frames back. flush_interval -1 sends every chunk as it arrives.
	reverse_proxy backend:8000 {
		flush_interval -1
	}
}

{$APP_HOST} {
	# the access log, to stdout (docker logs; the compose logging limit applies: 5 files of 10 MB): it is how the VM's request rate is measured (story 4796: the machine traffic of the prod move, RUNBOOK §12).
	# No credential is kept: the request headers and the response headers are removed (Caddy hides Authorization and Cookie by default, this keeps the rest of them out too) and so is the whole URI
	# (one-time codes of OAuth callbacks travel in the query string, invitation and public-document tokens in the path: /api/v2/invites/{token}, /api/v2/public/docs/{token}). What is left: time, host, method, status, size, duration,
	# and the client address (Caddy's remote_ip / client_ip, the same as Cloud Run's remoteIp in its request log): an address is personal data, so this log is read for its counts and is not shipped anywhere.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}

	encode zstd gzip
	reverse_proxy frontend:3000 {
		flush_interval -1
	}
}
