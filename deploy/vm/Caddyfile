# story 4796 — front door. Certificates are issued and renewed by Caddy itself (ports 80/443 must reach it).
# Caddy overwrites any X-Forwarded-For a client sends (no trusted proxies are configured), so the backend's TRUST_FORWARDED_FOR sees the real peer.
# The browser-facing API/MCP/realtime hosts are DNS-only (not behind the Cloudflare proxy) because long-lived SSE is buffered there (design doc §front door).
{
	email {$ACME_EMAIL}
	# the default log of Caddy (its stream of errors, stderr): the same filter as the access log of the two sites below.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}
	servers {
		protocols h1 h2
	}
}

{$API_HOST}, {$REALTIME_HOST} {
	# the access log, to stdout (docker logs; the compose logging limit applies: 5 files of 10 MB): it is how the VM's request rate is measured (story 4796: the machine traffic of the prod move, RUNBOOK §12).
	# No credential is kept: the request headers and the response headers are removed (Caddy hides Authorization and Cookie by default, this keeps the rest of them out too) and so is the whole URI
	# (one-time codes of OAuth callbacks travel in the query string, invitation and public-document tokens in the path: /api/v2/invites/{token}, /api/v2/public/docs/{token}). What is left: time, host, method, status, size, duration,
	# and the client address (Caddy's remote_ip / client_ip, the same as Cloud Run's remoteIp in its request log): an address is personal data, so this log is read for its counts and is not shipped anywhere.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}

	# no `encode`: compressing would hold SSE frames back. flush_interval -1 sends every chunk as it arrives.
	reverse_proxy backend:8000 {
		flush_interval -1
	}
}

{$APP_HOST} {
	# the access log, to stdout (docker logs; the compose logging limit applies: 5 files of 10 MB): it is how the VM's request rate is measured (story 4796: the machine traffic of the prod move, RUNBOOK §12).
	# No credential is kept: the request headers and the response headers are removed (Caddy hides Authorization and Cookie by default, this keeps the rest of them out too) and so is the whole URI
	# (one-time codes of OAuth callbacks travel in the query string, invitation and public-document tokens in the path: /api/v2/invites/{token}, /api/v2/public/docs/{token}). What is left: time, host, method, status, size, duration,
	# and the client address (Caddy's remote_ip / client_ip, the same as Cloud Run's remoteIp in its request log): an address is personal data, so this log is read for its counts and is not shipped anywhere.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				request>uri delete
			}
		}
	}

	# story 4843 — `/api/v2/*` on the app name goes STRAIGHT to the backend, not through the web server's rewrite (next.config.ts `rewrites()` -> the API name -> this front door a second time). The agents' clients
	# (a Bearer key, no cookie) reach the API on this name too, and their stream (`GET /api/v2/agent/stream`, ended by the backend every ~5 minutes on purpose) went through that rewrite: measured on dev, when the
	# upstream of a rewritten response is cut the web server never ends the client's side of it (locally, Next 16.2.2: 20 of 20 left open, `head sent`, for good), so ~36 an hour piled up in `next-server` and in
	# this front door (168 requests in flight here against 62 at the backend), and both processes grew by the day (prod 2026-11-01 -> 11-03: next-server 689 -> 1021 MB, caddy 327 -> 663 MB; the VM stopped answering
	# on 11-04). Here a cut upstream ends the client's connection, and the response is not compressed (`encode` would hold back and re-encode an event stream: the API name has none either).
	# The web UI does not use this path with its cookie (its calls go through its own `/api/...` routes, never `/api/v2/...` directly: the backend would answer 401 to a cookie), so nothing it depends on skips the web server.
	handle /api/v2/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:3000 {
			flush_interval -1
		}
	}
}
