[Unit]
Description=Sprintable database backup (pg_dump -Fc to Cloud Storage)
After=docker.service sprintable-gateway-db-firewall.service
Requires=docker.service
Wants=sprintable-gateway-db-firewall.service
ConditionPathIsMountPoint=/srv/sprintable

[Service]
Type=oneshot
ExecStart=/opt/sprintable/bin/backup.sh
TimeoutStartSec=3600
