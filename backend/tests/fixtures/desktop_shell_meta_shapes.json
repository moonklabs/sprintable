      "const": true,
      "required": true
    }
  },
  "desktop_first_task_handed": {
    "via": {
      "enum": [
        "start",
        "turn"
      ],
      "required": true
    }
  },
  "desktop_setup_blocked": {
    "reason": {
      "enum": [
        "managed_mcp"
      ],
      "required": true
    },
    "runtime": {
      "enum": [
        "claude",
        "codex"
      ],
      "required": false
    },
    "when": {
      "enum": [
        "after_start",
        "found"
      ],
      "required": false
    }
  },
  "desktop_setup_signed_in": {},
  "desktop_workdir_fallback": {
    "hinted": {
      "required": true,
      "type": "bool"
    }
  }
}
